# Copy to .env.local for local dev (never commit real values).

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Auth mode: "dev" (offline POST /api/v1/dev/login) or "cognito" (Hosted UI + PKCE)
VITE_AUTH_MODE=dev

# Cognito. Only used when VITE_AUTH_MODE=cognito (public app client, no secret).
# VITE_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# VITE_COGNITO_CLIENT_ID=<app-client-id>
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback
