# Copy to .env and fill in real values.
#   cp .env.example .env
# .env is git-ignored. This file is safe to commit.

# Django. Generate a real SECRET_KEY for local use.
SECRET_KEY=change-me-generate-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Browser SPA origins. Comma-separated. Leave empty for API-only work.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://demo.example.com

# Shared cache. Leave unset for LocMem (dev/test/CI). Needed in prod so
# throttle counters and webhook de-dupe work across gunicorn workers.
# CACHE_URL=redis://127.0.0.1:6379/0
# REDIS_URL=redis://127.0.0.1:6379/0

# Throttle rates. Defaults: anon 30/min, authenticated read 120/min, write 60/min.
# THROTTLE_ANON_RATE=30/min
# THROTTLE_USER_READ_RATE=120/min
# THROTTLE_IDENTITY_WRITE_RATE=60/min

# Database. SQLite unless you set PostgreSQL here.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=api_web_framework
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# JWT. local = offline HS256 (dev/CI). cognito = real pool.
AUTH_ISSUER=local
AUTH_LOCAL_SIGNING_KEY=test-only-local-signing-key-not-for-production
AUTH_LOCAL_ISSUER=https://local.test/issuer
AUTH_LOCAL_AUDIENCE=api-web-framework

# Cognito placeholders. Set AUTH_ISSUER=cognito to use them.
# Issuer and JWKS URL are derived from region + pool id if you leave them blank.
# COGNITO_REGION=eu-west-1
# COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
# COGNITO_APP_CLIENT_ID=your-app-client-id
# COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_XXXXXXXXX
# COGNITO_JWKS_URL=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_XXXXXXXXX/.well-known/jwks.json

# Do not put real AWS / Cognito / Stripe secrets in this file.

# Payments. disabled = no Stripe account needed.
# PAYMENT_PROVIDER=disabled
# STRIPE_SECRET_KEY=sk_test_placeholder_not_a_real_key
# STRIPE_WEBHOOK_SECRET=whsec_placeholder_not_a_real_secret

# Secrets helper (config/secrets.py). Default is environment variables.
# SECRETS_BACKEND=env
#
# Optional: read named secrets from AWS SSM using the instance / task role.
# SECRETS_BACKEND=aws
# When aws, DATABASE_URL is the SSM path, not a postgres URL.
# Example: /myapp/prod/DATABASE_URL whose value is postgresql://user:pass@host:5432/dbname.

# Docker Compose
# POSTGRES_USER=app
# POSTGRES_PASSWORD=choose-a-local-compose-password
# POSTGRES_DB=api_web_framework
# WEB_PORT=8000

# Production overlay (config.settings.prod). Put these in a git-ignored .env.prod.
# SECRET_KEY=generate-a-long-random-value-at-least-50-chars
# DEBUG is forced False in prod.
# ALLOWED_HOSTS=example.com,api.example.com
# DATABASE_URL=postgresql://dbuser:password@db.example.com:5432/mydb
# CACHE_URL=redis://cache.example.com:6379/0
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# AUTH_ISSUER=cognito
# (When AUTH_ISSUER=cognito, also set COGNITO_REGION, COGNITO_USER_POOL_ID,
#  COGNITO_APP_CLIENT_ID.)
